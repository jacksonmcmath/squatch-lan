# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your actual values

# Proxmox configuration (existing)
proxmox = {
  name      = "your-proxmox-server"
  endpoint  = "https://your-proxmox-server:8006/"
  insecure  = true
  username  = "your-username"
  api_token = "your-api-token"
}

# OCI configuration
oci = {
  tenancy_ocid     = "ocid1.tenancy.oc1..your-tenancy-ocid"
  user_ocid        = "ocid1.user.oc1..your-user-ocid"
  fingerprint      = "your-api-key-fingerprint"
  private_key_path = "~/.oci/your-private-key.pem"
  region           = "us-ashburn-1"  # or your preferred region
}

# OCI compartment OCID (required for the example)
oci_compartment_id = "ocid1.compartment.oc1..your-compartment-ocid"
